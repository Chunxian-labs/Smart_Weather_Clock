{
    "configurations": [
        {
            "name": "CrossARM",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Firmware/CMSIS/core",
                "${workspaceFolder}/Firmware/CMSIS/device",
                "${workspaceFolder}/Firmware/driver/inc",
                "${workspaceFolder}/drivers",
                "${workspaceFolder}/app"
            ],
            "defines": [
                "STM32F40_41xxx",
                "USE_STDPERIPH_DRIVER"
            ],
            "compilerPath": "D:/Embedded_Toolchain/Arm-GNU-Toolchain/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}